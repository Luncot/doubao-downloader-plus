[
  {
    "id": 1,
    "priority": 2,
    "action": {
      "type": "redirect",
      "redirect": {
        "regexSubstitution": "\\1lr=unwatermarked"
      }
    },
    "condition": {
      "regexFilter": "(\\?|&)lr=(?:video_gen_watermark(?:_dyn)?|watermark(?:_dyn)?)",
      "resourceTypes": ["media"]
    }
  },
  {
    "id": 2,
    "priority": 2,
    "action": {
      "type": "redirect",
      "redirect": {
        "regexSubstitution": "\\1lr=video_gen_no_watermark"
      }
    },
    "condition": {
      "regexFilter": "(\\?|&)lr=video_gen_watermark(?:_dyn)?",
      "resourceTypes": ["media"],
      "initiatorDomains": ["doubao.com"]
    }
  },
  {
    "id": 3,
    "priority": 2,
    "action": {
      "type": "redirect",
      "redirect": {
        "transform": {
          "queryTransform": {
            "removeParams": ["logo_type"]
          }
        }
      }
    },
    "condition": {
      "urlFilter": "logo_type=video_gen_watermark_dyn",
      "resourceTypes": ["media"]
    }
  },
  {
    "id": 4,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        { "header": "Access-Control-Allow-Origin", "operation": "set", "value": "*" },
        { "header": "Access-Control-Allow-Methods", "operation": "set", "value": "GET, POST, OPTIONS" }
      ]
    },
    "condition": {
      "urlFilter": "||dola.com/samantha/",
      "resourceTypes": ["xmlhttprequest", "media"]
    }
  }
]
